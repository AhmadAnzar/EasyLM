GROQ_API_KEY=groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: "local" (default) runs a small model on your machine - free, no key, no rate limits.
# Use "voyage" to call Voyage AI instead (needs VOYAGE_API_KEY; the free tier is heavily rate limited).
EMBEDDING_PROVIDER=local
# Default is fast. BAAI/bge-small-en-v1.5 is the alternative (about 2-3x slower to index).
# (The older name EMBEDDING_MODEL is still honoured when this one is not set.)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# VOYAGE_API_KEY=voyage_api_key

# Vector database: leave QDRANT_URL / QDRANT_API_KEY out (or set QDRANT_URL=local) to store vectors locally.
QDRANT_URL=qdrant_url_or_local
QDRANT_API_KEY=qdrant_api_key
QDRANT_COLLECTION=easy_lm_docs

# Login sessions are signed with this. Set a long random value on a deployed backend, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset means a new random secret on every start, so everyone is logged out after a restart.
# SESSION_SECRET=choose-a-long-random-value
# Where user accounts are stored (a small collection in the same Qdrant), and how many workspaces each may have.
# USERS_COLLECTION=easylm_users
# MAX_WORKSPACES_PER_USER=5
# Upload limits: sources per workspace, file size in MB and pasted text length in characters.
# MAX_SOURCES_PER_WORKSPACE=5
# MAX_UPLOAD_MB=25
# MAX_TEXT_CHARS=200000
# Browser origins allowed to call the API (comma separated). Unset means any origin.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
