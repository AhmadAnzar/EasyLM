GROQ_API_KEY=groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: "local" (default) runs a small model on your machine - free, no key, no rate limits.
# Use "voyage" to call Voyage AI instead (needs VOYAGE_API_KEY; the free tier is heavily rate limited).
EMBEDDING_PROVIDER=local
# Default is fast. BAAI/bge-small-en-v1.5 is the alternative (about 2-3x slower to index).
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# VOYAGE_API_KEY=voyage_api_key

# Vector database: leave QDRANT_URL / QDRANT_API_KEY out (or set QDRANT_URL=local) to store vectors locally.
QDRANT_URL=qdrant_url_or_local
QDRANT_API_KEY=qdrant_api_key
QDRANT_COLLECTION=easy_lm_docs
